<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config: Permits cleartext for local Wi-Fi development & debugging -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <!-- Specific domain cleartext permissions -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">192.168.29.195</domain>
        <domain includeSubdomains="true">faczz.app</domain>
    </domain-config>
</network-security-config>
